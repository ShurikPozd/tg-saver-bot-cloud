BOT_TOKEN=your_telegram_bot_token
# Telethon: https://my.telegram.org -> API development tools
API_ID=
API_HASH=
# Владелец бота (числовой user_id) - для бэкапов на эфемерном диске,
# когда база пуста. Узнать свой user_id можно у @userinfobot.
OWNER_ID=
# MTProto-прокси (t.me/proxy -> server/port/secret).
# Если код запускается локально - порт SOCKS (host.docker.internal:1080). На Render оставить пустым.
MT_PROXY_HOST=
MT_PROXY_PORT=1080
MT_PROXY_SECRET=
# Groq API (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_STT_MODEL=whisper-large-v3-turbo
# Прокси для Groq (socks5://... для локальной разработки). На сервере (Render) пусто.
GROQ_PROXY=
GROQ_TIMEOUT_SEC=300
# HTTP-порт для health-чека (Render прокидывает PORT). 0 - сервер не поднимается.
HTTP_PORT=8080
# Секрет для POST /api/chat (расширение «Сводка комментариев YouTube»).
# Проверяется по заголовку X-Sec-Token через hmac.compare_digest. Если пусто - 403.
EXT_SECRET=
# Разрешённые модели для /api/chat (через запятую). По умолчанию - GROQ_MODEL.
EXT_MODELS_ALLOW=
# Потолок размера скачиваемого видео через /api/download (байты). Тяжёлые видео не наш вариант.
EXT_DL_MAX_BYTES=314572800
# Разрешённые качества для /api/download.
EXT_DL_QUALITIES=best,1080,720,480,360
# Приватный канал-хранилище (бот = админ): сюда кладутся тихие снимки экспорта.
BACKUP_CHANNEL_ID=
# GitHub-синк бэкапов: при каждом бэкапе бот пушит экспорт (gzip) в репозиторий,
# а при потере БД (эфемерный диск Render) сам его восстанавливает.
GITHUB_TOKEN=
GITHUB_REPO=ShurikPozd/tg-saver-backups
GITHUB_BRANCH=main
GITHUB_PATH=backups
# Seed-файл (JSON) для первичного восстановления, когда БД и GitHub пусты.
SEED_FILE=tg_saver_seed.json