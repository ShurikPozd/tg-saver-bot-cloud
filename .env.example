BOT_TOKEN=your_telegram_bot_token
# Telethon: https://my.telegram.org -> API development tools
API_ID=
API_HASH=
# Владелец бота (числовой user_id) — используется для бэкапов экспорта в TG.
# Заполняется вручную первым сообщением, но надёжнее указать явно в env.
OWNER_ID=
# MTProto-прокси (t.me/proxy ссылка -> server/port/secret).
# НУЖЕН локально из РФ (host.docker.internal:1080). На Render оставь пустым — прямое соединение.
MT_PROXY_HOST=
MT_PROXY_PORT=1080
MT_PROXY_SECRET=
# Groq API (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_STT_MODEL=whisper-large-v3-turbo
# Прокси до Groq (нужен из РФ). На зарубежном хосте (Render) пусто.
GROQ_PROXY=
GROQ_TIMEOUT_SEC=300
# HTTP-порт для health-чека (Render сам прокидывает PORT). 0 — не поднимать.
HTTP_PORT=8080